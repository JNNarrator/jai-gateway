{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JAI",
  "version": "0.1.1",
  "identifier": "app.jai.gateway",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JAI Gateway",
        "width": 980,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica", "acrylic", "blur"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRURFNTc5QURGRjc3OTkKUldTWmQvK3RlZVh0MnVpeFhPNWs3N0NVVDZuWnQ2VFltN3ZRRitoT2t1bndXa3NBR1BnRjhIU1QK",
      "endpoints": [
        "https://github.com/JNNarrator/jai-gateway/releases/latest/download/latest.json"
      ]
    }
  }
}
